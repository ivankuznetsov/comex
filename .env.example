# Optional locally until live generation is configured. Store real values in 1Password.
OPENAI_API_KEY=
# Model names and access must be verified against your OpenAI account.
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=
# Required before any OpenAI call: a positive call cap or the explicit value unlimited.
# A numeric limit caps total calls, not currency spend.
COMEX_MAX_PROVIDER_CALLS=
# Optional; defaults to one simultaneous call.
COMEX_MAX_CONCURRENT_CALLS=1
# Email sign-in: use a verified Resend sender, store the API key in 1Password.
# Must match the exact origin used by the browser. HTTP is accepted only for localhost.
COMEX_APP_URL=http://localhost:3000
COMEX_EMAIL_FROM=
RESEND_API_KEY=
COMEX_AUTH_SECRET=
# Hosted persistence (provision and migrate explicitly; never use local credentials here).
DATABASE_URL=
# Token must belong to a private Vercel Blob store. Keep it in 1Password.
BLOB_READ_WRITE_TOKEN=
# Separate managed 32+ character secret for OAuth signing and encrypted signing keys.
COMEX_MCP_AUTH_SECRET=
# Operator-provisioned shared secret for a specific local-to-hosted import.
COMEX_IMPORT_HANDOFF_SECRET=
# On the original local installation only, set the canonical destination origin.
COMEX_IMPORT_DESTINATION_URL=
